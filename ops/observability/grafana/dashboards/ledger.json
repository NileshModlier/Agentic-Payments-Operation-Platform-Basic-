{
  "uid": "apop-ledger",
  "title": "APOP Ledger",
  "tags": ["apop", "ledger"],
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Postings",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (entry_type, result) (rate(apop_ledger_post_total[5m]))", "legendFormat": "{{entry_type}} {{result}}"}]
    },
    {
      "type": "timeseries",
      "title": "Ledger request p99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"ledger-service\"}[5m])))", "legendFormat": "{{uri}}"}]
    },
    {
      "type": "timeseries",
      "title": "Hikari active connections",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"ledger-service\"}", "legendFormat": "active"}]
    },
    {
      "type": "timeseries",
      "title": "Outbox unpublished age",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "apop_outbox_unpublished_age_seconds{job=\"ledger-service\"}", "legendFormat": "seconds"}]
    }
  ]
}
